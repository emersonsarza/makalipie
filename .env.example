NEXT_PUBLIC_SITE_URL=https://makalipie.com
# Optional override for the Grab store link. The default lives in src/lib/site.ts.
NEXT_PUBLIC_GRABFOOD_URL=

# Optional Google Search Console HTML verification token (not the full meta tag).
GOOGLE_SITE_VERIFICATION=

# Server-only Supabase settings. Copy this file to .env.local and fill these in.
# Never commit real values. The secret key bypasses row security.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional local-only password used by `npm run allowlist-owner` to create
# nika@makalipie.com when that user does not exist yet. Leave this empty and
# create the user in the Supabase dashboard instead. Never commit a real password.
# OWNER_PASSWORD=

# How long a public catalog snapshot may be reused after the last owner save.
# Eligibility is still calculated on each request. Default is one day.
# STOREFRONT_CACHE_TTL_SECONDS=86400

# Label stamped on encrypted backups. Local development uses local.
# BACKUP_ENVIRONMENT=local
