{
  "name": "makalipie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:admin": "node --import tsx --test tests/admin-access.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-makalipie \"node --import tsx --test tests/firestore-rules.test.ts\"",
    "admin:bootstrap": "node --env-file=.env.local --conditions=react-server --import tsx scripts/bootstrap-owner.ts",
    "emulators": "firebase emulators:start --only auth,firestore,storage --project demo-makalipie",
    "emulators:seed": "node --conditions=react-server --import tsx scripts/seed-admin-emulator.ts",
    "dev:emulators": "node scripts/dev-emulators.mjs",
    "test:session": "node --conditions=react-server --import tsx --test tests/admin-session.integration.ts",
    "test:products": "node --conditions=react-server --import tsx --test tests/products.integration.ts",
    "test:catalog": "node --import tsx --test tests/catalog.test.ts",
    "test:catalog:integration": "node --conditions=react-server --import tsx --test tests/catalog.integration.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.20.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.103.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
