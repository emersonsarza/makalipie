{
  "name": "makalipie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:catalog": "node --import tsx --test tests/catalog.test.ts",
    "test:branches": "node --import tsx --test tests/branches.test.ts",
    "test:scheduling": "node --import tsx --test tests/scheduling.test.ts",
    "test:phase1": "node --env-file=.env.local --import tsx --test tests/phase1-database.test.ts tests/phase1-auth.test.ts",
    "test:phase2": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/phase2-eligibility.test.ts tests/phase2-catalog.test.ts",
    "test:phase3": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/phase3-drops.test.ts",
    "test:phase4": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/phase4-orders.test.ts",
    "test:phase5": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/phase5-realtime.test.ts",
    "test:phase6": "node --env-file=.env.local --import tsx --test --test-concurrency=1 tests/phase6-backups.test.ts",
    "test:handoff": "npm run test:phase1 && npm run test:phase2 && npm run test:phase3 && npm run test:phase4 && npm run test:phase5 && npm run test:phase6",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:env": "node scripts/write-local-env.mjs",
    "allowlist-owner": "node --env-file=.env.local --import tsx scripts/allowlist-owner.ts",
    "verify:sandbox": "npx supabase db query --remote --yes --file scripts/verify-sandbox.sql",
    "test:admin-query": "node --import tsx --test tests/admin-query.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "age-encryption": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "jose": "^6.2.17",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.1",
    "supabase": "^3.1.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
